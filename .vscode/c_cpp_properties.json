{
    "configurations": [
        {
            "name": "Windhawk",
            "compilerPath": "D:/Windhawk/Compiler/bin/clang++.exe",
            "compilerArgs": [
                "--target=x86_64-w64-mingw32"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "D:/Windhawk/Compiler/include"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "WINVER=0x0A00",
                "_WIN32_WINNT=0x0A00",
                "_WIN32_IE=0x0A00",
                "NTDDI_VERSION=0x0A000008",
                "__USE_MINGW_ANSI_STDIO=0",
                "WH_MOD",
                "WH_EDITING"
            ],
            "forcedInclude": [
                "windhawk_api.h"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "windows-clang-x64"
        }
    ],
    "version": 4
}